# mcp-uml-diagram — environment variables
#
# HOW THESE ARE LOADED. This server reads os.environ directly and does NOT load
# a .env file — there is no python-dotenv dependency and no load_dotenv() call
# in the repo. An MCP server receives its environment from the MCP client, so
# these belong in the client config: for Claude Code, ~/.claude/settings.json
# under mcpServers -> uml-diagram -> env. Copying this file to .env has no
# effect.

# UML_OUTPUT_DIR — optional. Default is `uml` beneath the project root.
# Precedence in _output_dir(): this variable, then the caller-supplied
# output_dir, then the `uml` default.
#
# NOTE: this file previously stated the default was `docs/uml/`. It is not —
# server.py resolves `env_dir or output_dir or "uml"`, root-relative. The wrong
# default mattered because rules/45 mandates UML output at the PROJECT ROOT in
# `uml/`, so a reader following this file would have moved output into `docs/`
# believing they were matching the documented default.
UML_OUTPUT_DIR=your_value_here

# ANTHROPIC_API_KEY — required for the Tier 2/3 LLM-assisted diagrams
# (use case, activity). Not read by this repo directly: it is consumed by
# claude-workflow-engine, which this server imports from
# (langgraph_engine.uml_generators). Listed here because it is part of this
# server's setup surface even though the read happens downstream.
ANTHROPIC_API_KEY=your_value_here

# KROKI_SERVER — NOT IMPLEMENTED. Read by nothing.
#
# This file described it as the "Kroki rendering server URL (default:
# https://kroki.io)", but KrokiRenderer hard-codes
# `KROKI_URL = "https://kroki.io"` in
# claude-workflow-engine/langgraph_engine/diagrams/kroki_renderer.py. There is
# currently no way to point rendering at a self-hosted Kroki instance, which
# matters for any diagram whose content should not leave the network.
#
# Its only other appearance anywhere is in
# claude-workflow-engine/scripts/tools/create_mcp_repos.py — the scaffolding
# script that GENERATED this file from a hard-coded list. That is the origin of
# this whole class of drift across the MCP repos: the examples were written from
# an intended variable list and never checked against the code that reads them.
# KROKI_SERVER=https://kroki.io
